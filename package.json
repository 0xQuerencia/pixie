{
  "name": "@pixie/pixie",
  "version": "1.0.0",
  "description": "Slack bot that answers help-channel questions from program docs and learned knowledge",
  "main": "index.ts",
  "scripts": {
    "start": "bun index.ts",
    "ask": "bun index.ts --ask",
    "manifest": "bun scripts/manifest.cjs",
    "migrate:check": "bun scripts/migrate-railway.mjs --check",
    "migrate:write": "bun scripts/migrate-railway.mjs --write",
    "migrate:dump": "bun scripts/migrate-railway.mjs --dump-expected",
    "archive:programs": "bun scripts/program-archive.ts",
    "reset:programs": "bun scripts/program-reset.ts",
    "smoke": "node scripts/smoke-test.js",
    "test:diff": "node scripts/test-diff.mjs",
    "test": "bun scripts/run-tests.mjs",
    "test:file": "bun test",
    "test:wizard": "bun scripts/run-tests.mjs --wizard",
    "test:all": "bun scripts/run-tests.mjs --all",
    "eval:support": "bun scripts/run-support-evals.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write \"index.ts\" \"lib/**/*.ts\"",
    "format:check": "prettier --check \"index.ts\" \"lib/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "ai": "^7.0.107",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "playwright": "^1.62.1",
    "prettier": "3",
    "typescript": "5.9.3"
  }
}
